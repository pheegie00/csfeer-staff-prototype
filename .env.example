# CSFeer Environment Configuration
# Copy this file to .env and update with your values
#
# NOTE: This file is for local development (outside Docker) and AWS deployments.
# For Docker-based development, compose.yml contains all necessary configuration.

# ===================================
# Environment
# ===================================
ENVIRONMENT=local  # Options: local, dev, staging, production

# ===================================
# AWS Secrets Manager (AWS Environments Only)
# ===================================
# Set to true to use AWS Secrets Manager for sensitive configuration
USE_SECRETS_MANAGER=false

# Name of the secret in AWS Secrets Manager containing application secrets
AWS_SECRET_NAME=csfeer-dev-secrets

# Name of the secret in AWS Secrets Manager containing database credentials
AWS_DB_SECRET_NAME=csfeer-dev-db-credentials

# AWS region where secrets are stored
AWS_REGION=us-east-1

# ===================================
# Django Configuration (Local Development)
# ===================================
SECRET_KEY=django-insecure-local-dev-key-change-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,0.0.0.0,ui.csfeer,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===================================
# Database Configuration (Local Development)
# ===================================
DB_CONFIG__PGHOST=localhost
DB_CONFIG__PGPORT=5432
DB_CONFIG__PGDATABASE=csfeer
DB_CONFIG__PGUSER=csfeer
DB_CONFIG__PGPASSWORD=secret123
DB_CONFIG__SSL_MODE=disable
DB_CONFIG__USE_IAM_AUTH=false
DB_CONFIG__STATEMENT_TIMEOUT=3600000

# ===================================
# OIDC/OAuth Configuration (Local Development)
# ===================================
USE_OIDC=true
OIDC_CONFIG__CLIENT_ID=csfeer-auth
OIDC_CONFIG__CLIENT_SECRET=shhhhhhhh
OIDC_CONFIG__DOCUMENT_URL=http://oauth.csfeer:8081/realms/csfeer/.well-known/openid-configuration
OIDC_CONFIG__FORCE_SECRET_WITH_PKCE=true

# ===================================
# API Configuration
# ===================================
API_KEY=your-api-key-here

# ===================================
# Logging Configuration
# ===================================
LOGGING_CONFIG__LEVEL=INFO
LOGGING_CONFIG__FILE_MAX_BYTES=10485760
LOGGING_CONFIG__FILE_BACKUP_COUNT=5

# ===================================
# Django Settings Module
# ===================================
DJANGO_SETTINGS_MODULE=csfeer.settings

# ===================================
# Keycloak Bootstrap (Local Development)
# ===================================
KC_BOOTSTRAP_ADMIN_CLIENT_ID=csfeer-admin
KC_BOOTSTRAP_ADMIN_CLIENT_SECRET=shhhhhhhh

# ===================================
# WeasyPrint Dependencies (macOS only)
# ===================================
# DYLD_LIBRARY_PATH=/opt/homebrew/lib

# ===================================
# Static Files (Optional)
# ===================================
# FRONTEND_BUILD_DIR=frontend/built
# STATIC_ROOT=/path/to/staticfiles
