# Personal access token with 'repo' scope (Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=ghp_your_token_here

# Repository to register the runner to
GITHUB_REPO=focusconsulting/csfeer

# Display name shown in GitHub Actions > Runners
RUNNER_NAME=<YOUR RUNNER NAME>

# Labels used to target this runner in workflows (runs-on: [self-hosted, ubuntu-24.04])
RUNNER_LABELS=self-hosted,ubuntu-latest,linux,x64

# Absolute path on the HOST where job workspaces are stored.
# Must be the same value inside and outside the container so that nested
# docker volume mounts (docker run -v <workspace-path>:...) resolve correctly
# against Docker Desktop's shared paths (which only knows about host paths).
RUNNER_WORK_DIR=/tmp/runner-work
